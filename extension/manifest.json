{
  "manifest_version": 3,
  "name": "UOOC 讨论回复助手",
  "version": "1.1.0",
  "description": "面向深圳大学 UOOC 慕课讨论区的定时回复助手，支持自定义间隔、倒计时进度条和后台执行。",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "alarms", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "UOOC 讨论回复助手" }
}
